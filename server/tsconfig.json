{
    "compilerOptions": {
        "module": "es2020",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2022",
        "noImplicitAny": false,
        "moduleResolution": "node",
        "inlineSourceMap": true,
        "outDir": "dist",
        "allowJs": true,
        "resolveJsonModule": true,
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "baseUrl": "./src",
        "incremental": true
    },
    "include": [
        "src/**/*",
    ],
    "exclude": [
        "node_modules"
    ],
    "ts-node": {
        "swc": true
    }
}