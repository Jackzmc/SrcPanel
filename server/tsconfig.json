{
    "compilerOptions": {
        "preserveSymlinks": true,
        "skipLibCheck": true,
        "module": "node20",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2022",
        "noImplicitAny": false,
        "moduleResolution": "nodenext",
        "sourceMap": true,
        // "inlineSourceMap": true,
        "rootDir": ".",
        "outDir": "./dist",
        "allowJs": true,
        "resolveJsonModule": true,
        "paths": {
            "*": [
                "./src/*"
            ]
        },
        "strictNullChecks": true,
        // "incremental": true
    },
    "include": [
        "./src/**/*",
    ],
    "exclude": [
        "node_modules"
    ],
    "ts-node": {
        "swc": true
    }
}
