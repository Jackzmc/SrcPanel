##-------------##
## Web         ##
##-------------##
SESSION_SECRET= # Random generated secret
CORS_WHITELIST=http://localhost:8080 # secretList of websites to whitelist cors
STATE_SECRET= # random generated secret
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=8080
 
##-------------##
## Database    ##
##-------------##
# MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock
MYSQL_HOST=localhost
MYSQL_DB=sourcemod
MYSQL_ADMINS_DB=panel-admins
MYSQL_USER=sourcemod
MYSQL_PASSWORD=sourcemod

##-------------##
## Discord Bot ##
##-------------##
# DISCORD_API_TOKEN=
# DISCORD_VOICELINK_CATEGORY_ID= # ID of the category that contains voice channels

##-------------##
## Live Plugin ##
##-------------##
LIVE_PLUGIN_HOSTNAME=0.0.0.0
LIVE_PLUGIN_PORT=7888
# LIVE_PLUGIN_DEBUG=1

##---------------##
## Server Docker ##
##---------------##
DOCKER_ENABLE=1 # Enable docker support for servers
#DOCKER_NAME_PREFIX=panel # Change the default prefix of 'panel' in 'panel-<group>-<instance port>'
#DOCKER_FORCE_PROTOCOL= # http/https/ssh
#DOCKER_HOST=
#DOCKER_PORT=
#DOCKER_VERSION=
# DOCKER_SERVER_READ_ONLY=0 # Make server manager not auto start / stop docker servers

