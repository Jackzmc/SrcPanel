{
    "my-custom-id": {
        // Required: Display name for a server
        "name": "My server 1",
        // Required: The type of game, see list at https://www.npmjs.com/package/gamedig
        "type": "left4dead2",
        // Required: The url of the server
        "ip": "127.0.0.1:27015",

        // The directory where the server configs are stored. Will scan for subfolder files as well.
        "cfgDirectory": "/home/steam/l4d2/left4dead2/cfg/",

        // For use with ActivityMonitor plugin
        "activityId": "myserver",
        
        // An ascending number (smallest first) that determines its order in lists.
        "sortOrder": 0,

        "rcon": {
            "password": {
                // One of these is needed, env will overwrite text
                // Text: Plain text raw password
                "text": "my-plaintext-password",
                // The name of the environmental variable that contains the password
                "env": "MY_ENV_THAT_HAS_PASSWORD"
            },
            // The command to use to exit, default is 'exit'
            // Won't be used if systemd is configured
            "exitCommand": "exit",
            // Request to restart restart command (in case you have plugin that will only conditionally exit (ex: players online)), optional or exit
            "requestExitCommand": "exit"
        },

        // Any custom tags, are just used for display purposes or API consumption
        "tags": []
        // Optional systemd configuration
        /*"systemd": {
            // If systemd is a user service
            "isUser": true, 
            // If server is with systemd, a service name to stop or start it
            "serviceName": "my-server-service"
        }*/
    }
}