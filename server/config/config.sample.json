{
    "refreshIntervalSeconds": 60,
    "servers": [
        {
            // Optional id for the server, used in api calls and in the url /servers/:id
            // If not provided, will be created from name1
            "id": "my-custom-id",
            // Required: Display name for a server
            "name": "My server 1",
            // The type of game, see list at https://www.npmjs.com/package/gamedig
            "type": "left4dead2",
            // Required: The url of the server
            "ip": "127.0.0.1:27015",

            // The directory where the server configs are stored. Will scan for subfolder files as well.
            "cfgDirectory": "/home/steam/l4d2/left4dead2/cfg/",

            "activityId": "myserver",
            
            // An ascending number (smallest first) that determines its order in lists.
            "sortOrder": 0,

            "rcon": {
                "password": {
                    // One of these is needed, env will overwrite text
                    // Text: Plain text raw password
                    "text": "my-plaintext-password",
                    // The name of the environmental variable that contains the password
                    "env": "MY_ENV_THAT_HAS_PASSWORD"
                },
                // The command to use to exit, default is 'exit'
                // Won't be used if systemd is configured
                "exitCommand": "exit",
                // Request to restart command, optional or exit
                "requestExitCommand": "exit"
            },
            // Any custom tags, to be passed to any api clients
            "tags": []
            // Optional systemd configuration
            /*"systemd": {
                // If systemd is a user service
                "isUser": true, 
                // If server is with systemd, a service name to stop or start it
                "serviceName": "my-server-service"
            }*/
        }
    ],
    // Optional list of addon shares
    "addons": {
        // Name of the addon share
        "default": {
            // The folder where the *.vpk files are located
            "sourceFolder": "/home/steam/content",
            // The appid this share is for. Optional. Used for limiting downloads so other game addons can't be installed to it
            "appid": 550,
            // List of destinations
            "destinations": [
                {
                    "id": "dest-1",
                    "name": "My Destination Display Name", // Optional
                    "serverIds": ["my-server-id"], // Optional
                    "path": "/home/steam/myserver-1/addons/"
                }
            ]
        }
    }
}