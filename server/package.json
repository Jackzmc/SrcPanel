  "main": "dist/src/index.js",
  "type": "module",
  "types": "fastify.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:proxy": "NODE_USE_ENV_PROXY=1 HTTPS_PROXY=http://localhost:8080 HTTP_PROXY=http://localhost:8080 pnpm start --use-env-proxy",
    "dev": "nodemon --signal SIGTERM -e ts --exec \"pnpm run build && pnpm run start || exit 1\"",
