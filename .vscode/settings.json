{
    "restoreTerminals.terminals": [
        {
            "splitTerminals": [
                {
                    "name": "nuxt",
                    /* sometimes first command gets skipped */
                    "commands": ["echo", "cd nuxt", "pnpm i", "pnpm dev --host 127.0.0.1"]
                }
            ]
        },
        {
            "splitTerminals": [
                {
                    "name": "server",
                    /* sometimes first command gets skipped */
                    "commands": ["echo", "cd server", "pnpm i", "pnpm dev"]
                },
            ]
        }
    ],
    "vue3snippets.enable-compile-vue-file-on-did-save-code": false,
    "cmake.configureOnOpen": false,
    "js.format.enable": false,
    "ts.format.enable": false,
    "eslint.enable": true,
    "eslint.format.enable": true,
    "eslint.validate": [
        "javascript",
        "typescript"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "terminals.terminals": [
        {
            "name": "UI",
            "commands": [
                "cd ui",
                "pnpm i",
                "pnpm serve"
            ]
        },
        {
            "name": "Server",
            "commands": [
                "cd server",
                "pnpm i",
                "pnpm dev"
            ]
        }
    ]
}