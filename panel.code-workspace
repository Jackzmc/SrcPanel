{
  "folders": [
    {
      "name": "root",
      "path": "."
    },
    {
      "name": "common",
      "path": "./common-types"
    },
    {
      "name": "server",
      "path": "./server"
    },
    {
      "name": "nuxt",
      "path": "./nuxt"
    },
    {
      "name": "db",
      "path": "./db"
    },
    {
      "name": "docs",
      "path": "./docs"
    }
  ],
  "settings": {
    "terminals.terminals": [
      {
        "name": "UI (Nuxt)",
        "persistent": "nuxt",
        "command": "cd nuxt; pnpm dev --host 127.0.0.1"
      },
      {
        "name": "Server",
        "persistent": "server",
        "command": "cd server; pnpm dev"
      }
    ],
    "terminals.autorun": false
  },
}