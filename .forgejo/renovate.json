{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays"
  ],
  "automerge": false,
  "prHourlyLimit": 1,
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "schedule": ["* 0 * * *"]
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchFileNames": [
        "nuxt/**"
      ],
      "groupName": "nuxt dependencies"
    },
    {
      "matchFileNames": [
        "server/**"
      ],
      "groupName": "fastify server dependencies"
    },
    {
      "matchFileNames": [
        "common-types/**"
      ],
      "groupName": "shared types dependencies"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "ignorePaths": ["ui/**"],
  "labels": ["dependencies"],
  "patch": { "enabled": false },
  "minimumReleaseAge": ""
}
