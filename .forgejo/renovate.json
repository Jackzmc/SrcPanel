{
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchFileNames": [
        "nuxt/**"
      ],
      "groupName": "nuxt dependencies"
    },
    {
      "matchFileNames": [
        "server/**"
      ],
      "groupName": "fastify server dependencies"
    },
    {
      "matchFileNames": [
        "common-types/**"
      ],
      "groupName": "shared types dependencies"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "ignorePaths": ["ui/**"],
  "labels": ["dependencies"],
  "patch": { "enabled": false }
}
