{
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchPaths": ["nuxt/**"],
      "groupName": "nuxt dependencies"
    },
    {
      "matchPaths": ["server/**"],
      "groupName": "fastify server dependencies"
    },
    {
      "matchPaths": ["common-types/**"],
      "groupName": "shared types dependencies"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "ignorePaths": ["ui/**"],
  "labels": ["dependencies"],
  "patch": { "enabled": false }
}